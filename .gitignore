# 汉化工程 .gitignore
# 依据：docs\68 建议 A-1「引入本地 git 仓库」
# 原则：**仓库只管「会变的东西」** —— 脚本、词库真源、报告、政策文档。
#       原件/试验二进制/截图/可从「脚本 + 词库」复算的产物一律不入库。

# ─────────────────────────────────────────────────────────────
# 1. 顶层大体量原件 / 试验二进制 / 截图取证（保持 backup 体系现状）
# ─────────────────────────────────────────────────────────────
/backup/
/archive/
/poc/
/_ref/

# ─────────────────────────────────────────────────────────────
# 2. work/ —— 只留脚本、政策文档与词库真源表
#    排除：_prose_dict/_xscn_dict 等派生词典、_regen-catfix 副本、
#          各 efile 的中间 tsv、out/ 产物、日志
# ─────────────────────────────────────────────────────────────
/work/**
!/work/**/
!/work/**/*.py
!/work/**/*.md
!/work/**/*.ps1
!/work/**/*.cmd
!/work/xscn/master-glossary.tsv
!/work/xscn/master-words.tsv
!/work/xscn/master-overrides.tsv

# ─────────────────────────────────────────────────────────────
# 3. peg/ —— 只留脚本、文档与 research/方法 真源
#    （testbed/backup 的原文与成品由脚本 + 词库复算）
# ─────────────────────────────────────────────────────────────
/peg/**
!/peg/**/
!/peg/**/*.py
!/peg/**/*.md
!/peg/**/*.ps1
!/peg/**/*.cmd
!/peg/research/
!/peg/research/**
!/peg/方法/
!/peg/方法/**

# ─────────────────────────────────────────────────────────────
# 4. pegww2/ —— 同上
# ─────────────────────────────────────────────────────────────
/pegww2/**
!/pegww2/**/
!/pegww2/**/*.py
!/pegww2/**/*.md
!/pegww2/**/*.ps1
!/pegww2/**/*.cmd
!/pegww2/research/
!/pegww2/research/**
!/pegww2/方法/
!/pegww2/方法/**
!/pegww2/docs-zh/
!/pegww2/docs-zh/**
!/pegww2/work/
!/pegww2/work/**
!/pegww2/README.md

# ─────────────────────────────────────────────────────────────
# 5. pgforever/ —— 只留脚本与文档
# ─────────────────────────────────────────────────────────────
/pgforever/**
!/pgforever/**/
!/pgforever/**/*.py
!/pgforever/**/*.md
!/pgforever/**/*.ps1
!/pgforever/**/*.cmd
!/pgforever/docs/
!/pgforever/docs/**
!/pgforever/tools/
!/pgforever/tools/**

# ─────────────────────────────────────────────────────────────
# 6. .workbuddy/ —— 只留 memory 真源（MEMORY/MECHANICS/归档）
# ─────────────────────────────────────────────────────────────
/.workbuddy/**
!/.workbuddy/**/
!/.workbuddy/**/*.md

# ─────────────────────────────────────────────────────────────
# 7. 全局：二进制 / 媒体 / 游戏数据格式 / 中间产物
#    放在白名单之后 —— gitignore 后出现的规则优先，故此处生效
# ─────────────────────────────────────────────────────────────
*.exe
*.dll
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.ico
*.zip
*.7z
*.rar
*.rtf
*.xls
*.xlsx
*.doc
*.docx

*.SCN
*.scn
*.MAP
*.map
*.cam
*.eqp
*.ply
*.xscn
*.STR
*.pgscn
*.pgeqp
*.pgbrf

# ─────────────────────────────────────────────────────────────
# 8. 派生 / 临时数据（工作区既有惯例：`_` 前缀 = 生成物，可复算）
#    必要性：若派生表入库，git status 将常驻 dirty，
#    A-1 要点 5「开工前 git status --short 审计」随即失效。
# ─────────────────────────────────────────────────────────────
**/_*.tsv
**/_*.txt
**/_*.jsonl
**/out-*/
**/_regen-*/
**/out/

*.log
*.bak
*.tmp
*.pre-*
*.before-*
*~
Thumbs.db
.DS_Store
